Windows Registry Editor Version 5.00

; Stash Open In Player - registers the stashplay:// URL scheme for the current
; user (no administrator rights required).
;
; Before importing, edit two things below:
;   - the path to stashplay.ps1, wherever you put it. Backslashes must be doubled
;     in .reg files.
;   - the Stash address in the Brave policy at the end, if you use Brave.
;
; PowerShell is started through "conhost.exe --headless" because powershell.exe
; is a console program: Windows opens its console window before PowerShell can
; act on -WindowStyle Hidden, so without conhost a terminal flashes up on every
; click.

[HKEY_CURRENT_USER\Software\Classes\stashplay]
@="URL:Stash External Player"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\stashplay\DefaultIcon]
@="C:\\Windows\\System32\\shell32.dll,115"

[HKEY_CURRENT_USER\Software\Classes\stashplay\shell]

[HKEY_CURRENT_USER\Software\Classes\stashplay\shell\open]

[HKEY_CURRENT_USER\Software\Classes\stashplay\shell\open\command]
@="\"C:\\Windows\\System32\\conhost.exe\" --headless \"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File \"C:\\Tools\\stashplay.ps1\" \"%1\""

; Brave only offers "Always allow" for stashplay:// links when Stash is served
; over HTTPS or from localhost. Over plain http:// on the LAN it asks on every
; click. This policy allows the scheme from the listed Stash address without the
; prompt. Set the exact origin you open Stash at: scheme, host and port, no
; trailing slash. Brave shows "Managed by your organization" once any policy is
; set; that is expected. For Chrome use Software\Policies\Google\Chrome, for Edge
; Software\Policies\Microsoft\Edge.

[HKEY_CURRENT_USER\Software\Policies\BraveSoftware\Brave]
"AutoLaunchProtocolsFromOrigins"="[{\"protocol\":\"stashplay\",\"allowed_origins\":[\"http://192.168.1.10:9999\"]}]"
