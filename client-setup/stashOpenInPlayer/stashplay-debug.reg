Windows Registry Editor Version 5.00

; DEBUG variant. Same as stashplay.reg but keeps a PowerShell window open so you
; can read the error. Import this, click the button, and the window stays up
; showing what went wrong. Re-import stashplay.reg when you are done.
;
; Edit the path to stashplay.ps1 below to match your install before importing.

[HKEY_CURRENT_USER\Software\Classes\stashplay]
@="URL:Stash External Player"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\stashplay\shell\open\command]
@="\"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -NoExit -ExecutionPolicy Bypass -File \"C:\\Tools\\stashplay.ps1\" \"%1\""
